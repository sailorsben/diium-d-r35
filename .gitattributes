* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.txt text eol=lf
*.asm text eol=lf
*.log text eol=lf
*.hex text eol=lf
# Preserve qualified UI inputs, including their historical trailing CRLF.
# Normalizing these bytes changes source hashes recorded in release proofs.
build/snes-mvp/ui-preview.c -text whitespace=cr-at-eol
build/snes-mvp/ui.c -text whitespace=cr-at-eol
build/snes-mvp/ui.h -text whitespace=cr-at-eol
# Evidence hashes describe published bytes; preserve those bytes in Git.
evidence/** -text -whitespace
docs/reference/** -text -whitespace
releases/**/snes-mvp binary
# Lab manifest hashes cover exact release bytes, including raw readelf output.
releases/platform-lab-1/** -text -whitespace
releases/platform-lab-2/** -text -whitespace
releases/device-survey-1/** -text -whitespace
releases/device-survey-2/** -text -whitespace
releases/spi-identify-1/** -text -whitespace
releases/spi-readback-1/** -text -whitespace
# Preserve the trailing blank line in lab2's hash-qualified wrapper fixture.
build/lab2-wrapper-check.py whitespace=-blank-at-eof
releases/**/platform-lab binary
*.png binary
