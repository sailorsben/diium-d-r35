# Publish authored source, curated evidence, documentation and owned releases.
# Keep full card/firmware exports, games, private progress and generated trees local.
*
!.gitignore
!.gitattributes
!README.md
!AGENTS.md
!CHANGELOG.md
!NOTICE.md
!docs/
!docs/**
!evidence/
!evidence/**
!releases/
!releases/**
!build/
!build/*.c
!build/*.h
!build/*.py
!build/*.sh
!build/core-source-commit.txt
!build/snes-mvp/
!build/snes-mvp/*.c
!build/snes-mvp/*.h
!build/snes-mvp/*.py
!build/snes-mvp/*.sh
!build/comparison-2010/
!build/comparison-2010/core-source-commit.txt
**/__pycache__/
**/*.pyc
**/*.o
**/saves/
**/states/
**/*.srm
**/*.state
**/*.state.bak
**/*.smc
**/*.sfc
**/sysroot/
